---
import { Phone } from '@lucide/astro'
import { whatsDefaultMessage } from '../utils/whatsMessage'

const message = whatsDefaultMessage()
---

<section
  class="h-screen w-full bg-gradient-to-b from-primary via-primary/40 to-background"
>
  <div
    class="flex items-center justify-center gap-8 h-full w-full max-w-[1300px] mx-auto animate-blurred-fade-in"
  >
    <article
      class="z-10 w-full max-w-6xl mx-auto pl-16 flex flex-col gap-6 flex-1"
    >
      <h1 class="md:text-6xl text-2xl font-bold text-white">
        Transforma su negocio con <strong>SAP</strong>
      </h1>
      <p class="md:text-xl text-lg text-pretty text-white">
        Somos especialistas en <strong
          >implementación, soporte y consultoría SAP</strong
        >. Ayudamos a empresas a <strong>optimizar sus procesos</strong> y
        <strong>alcanzar la excelencia operacional</strong>.
      </p>

      <div class="flex items-center gap-4">
        <a
          id="cta"
          href={message}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-6 py-2 text-md rounded-xl bg-primary/80 hover:bg-primary transition-all duration-300 hover:shadow-lg hover:shadow-primary/20 text-white hover:scale-105 group"
          ><Phone class="w-6 h-6 group-hover:rotate-6 transition-transform" /> Solicitar
          asesoría gratuita</a
        >
        <a
          id="cta"
          href="/servicios"
          class="px-6 py-2 text-md rounded-xl border border-primary text-primary hover:bg-primary/20 transition-all duration-300 hover:shadow-lg hover:shadow-primary/20 hover:scale-105 group"
          >Ver Servicios</a
        >
      </div>
    </article>

    <div
      class="w-full h-3/4 flex-1 flex items-center justify-center rounded-2xl overflow-hidden bg-background-cards group"
    >
      <img
        src="https://inforges.es/wp-content/uploads/2024/03/que-es-sap-soluciones-sap-que-transforman-los-negocios.jpg"
        alt=""
        class="w-auto h-full object-cover object-center scale-110 group-hover:scale-105 transition-all duration-300"
      />
    </div>
  </div>
</section>
