---

---

<section
  id="que-es-sap"
  class="w-full py-12 sm:py-16 md:py-20 px-4 sm:px-6 md:px-8 lg:px-0 bg-background animate-fade-in-up"
>
  <div
    class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-24 items-center"
  >
    <!-- Texto principal -->
    <article
      class="space-y-6"
      itemscope
      itemtype="https://schema.org/TechArticle"
    >
      <header class="space-y-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight text-gray-900"
          itemprop="headline"
        >
          La plataforma empresarial más confiable del mundo
        </h2>
        <p
          class="text-base sm:text-lg md:text-xl text-gray-700"
          itemprop="description"
        >
          SAP (Systems, Applications & Products in Data Processing) es una
          compañía alemana de software empresarial que ayuda a organizaciones de
          todos los tamaños a optimizar sus procesos y tomar decisiones basadas
          en datos.
        </p>
      </header>

      <p class="text-base sm:text-lg text-gray-700" itemprop="abstract">
        Con más de 50 años de innovación, SAP impulsa a más de
        <strong class="font-semibold">440&nbsp;000&nbsp;clientes</strong> en
        <strong class="font-semibold">180&nbsp;países</strong> para ejecutar sus
        negocios con eficiencia, resiliencia y sostenibilidad.
      </p>

      <!-- Métricas destacadas -->
      <dl
        class="grid grid-cols-2 gap-4 sm:gap-6 mt-6 sm:mt-8"
        aria-label="Datos destacados de SAP"
      >
        <div
          class="flex flex-col items-start"
          itemprop="accountablePerson"
          itemscope
          itemtype="https://schema.org/Organization"
        >
          <dt class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary">
            440K+
          </dt>
          <dd class="text-sm sm:text-base text-gray-600">Clientes globales</dd>
        </div>
        <div class="flex flex-col items-start">
          <dt class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary">
            180+
          </dt>
          <dd class="text-sm sm:text-base text-gray-600">Países</dd>
        </div>
      </dl>
    </article>

    <!-- Imagen ilustrativa -->
    <figure class="w-full">
      <img
        src="https://inesdi-cdn.s3.eu-west-3.amazonaws.com/inesdi-prod/2025-01/SAP.jpg"
        srcset="https://inesdi-cdn.s3.eu-west-3.amazonaws.com/inesdi-prod/2025-01/SAP.jpg?width=480 480w,
                https://inesdi-cdn.s3.eu-west-3.amazonaws.com/inesdi-prod/2025-01/SAP.jpg?width=768 768w"
        sizes="(max-width: 1024px) 100vw, 50vw"
        alt="Panel de control con soluciones SAP en múltiples dispositivos"
        width="960"
        height="640"
        loading="lazy"
        class="rounded-lg shadow-md object-cover w-full h-auto"
        itemprop="image"
      />
    </figure>
  </div>

  <!-- Datos estructurados para SEO -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org/",
      "@type": "TechArticle",
      "headline": "¿Qué es SAP? La plataforma empresarial más confiable del mundo",
      "description": "SAP es el líder mundial en software de planificación de recursos empresariales (ERP) y ayuda a más de 440 000 organizaciones en 180 países.",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://infralux.com/#que-es-sap"
      },
      "publisher": {
        "@type": "Organization",
        "name": "INFRALUX",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infralux.com/logo.png"
        }
      },
      "image": "https://inesdi-cdn.s3.eu-west-3.amazonaws.com/inesdi-prod/2025-01/SAP.jpg"
    }
  </script>
</section>
