---
import { LucideMenu, LucideX } from '@lucide/astro'

const { pathname } = Astro.url

// Resaltar la clase activa en el menú de navegación
const isActive = (path: string) => pathname === path
---

<header
  class="fixed top-0 left-0 right-0 z-50 flex justify-between md:justify-center items-center py-4 sm:py-6 md:py-8 px-4 sm:px-6 md:px-8 w-full max-w-6xl md:mx-auto"
>
  <a
    href="/"
    class="font-family-title tracking-widest font-semibold text-2xl sm:text-3xl md:hidden"
  >
    INFRALUX
  </a>
  <!-- Desktop Nav -->
  <nav class="hidden md:flex gap-8 items-center justify-center">
    <ul class="flex gap-6 lg:gap-8 text-lg lg:text-xl font-thin">
      <li>
        <a
          href="/sobre-nosotros"
          class={`inline-block hover:text-emphasis hover:scale-105 transition-all duration-300 ${
            isActive('/sobre-nosotros') ? 'text-primary' : ''
          }`}>Nosotros</a
        >
      </li>
      <li>
        <a
          href="/sap"
          class={`inline-block hover:text-emphasis hover:scale-105 transition-all duration-300 ${
            isActive('/sap') ? 'text-primary' : ''
          }`}
          >¿Qué es SAP?
        </a>
      </li>
      <li>
        <a
          href="/"
          class={`font-family-title tracking-widest text-xl lg:text-2xl hover:scale-105 transition-transform duration-300 inline-block font-semibold ${
            isActive('/') ? '' : ''
          }`}>INFRALUX</a
        >
      </li>
      <li>
        <a
          href="/servicios"
          class={`inline-block hover:text-emphasis hover:scale-105 transition-all duration-300 ${
            isActive('/servicios') ? 'text-primary' : ''
          }`}>Servicios</a
        >
      </li>
      <li>
        <a
          href="/contacto"
          class={`inline-block hover:text-emphasis hover:scale-105 transition-all duration-300 ${
            isActive('/contacto') ? 'text-primary' : ''
          }`}>Contacto</a
        >
      </li>
    </ul>
  </nav>

  <!-- Mobile Nav Button -->
  <button
    id="mobile-menu-btn"
    class="md:hidden p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 hover:bg-primary/10 transition-colors duration-200"
    aria-label="Abrir menú"
  >
    <LucideMenu class="w-6 h-6 text-text" />
  </button>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 bg-black/70 z-[100] flex justify-end transition-all duration-300 opacity-0 pointer-events-none"
>
  <nav
    class="bg-background w-4/5 max-w-sm h-full p-6 sm:p-8 flex flex-col gap-6 sm:gap-8 shadow-xl relative transform translate-x-full transition-transform duration-300"
  >
    <button
      id="mobile-menu-close"
      class="absolute top-4 right-4 p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 hover:bg-primary/10 transition-colors duration-200"
      aria-label="Cerrar menú"
    >
      <LucideX class="w-6 h-6 sm:w-8 sm:h-8 text-primary" />
    </button>

    <!-- Logo en el menú móvil -->
    <div class="mt-8 sm:mt-12 w-full flex justify-center">
      <a href="/" class={`md:hidden`}>
        <img src="/logo_blue.webp" alt="INFRALUX" class="h-36 w-auto" />
      </a>
    </div>

    <ul class="flex flex-col gap-6 sm:gap-8 text-lg sm:text-xl font-thin">
      <li class="border-b pb-3 border-secondary/20">
        <a
          href="/sobre-nosotros"
          class={`inline-block py-2 hover:text-primary transition-colors duration-200 ${isActive('/sobre-nosotros') ? 'text-primary' : ''}`}
          >Nosotros</a
        >
      </li>
      <li class="border-b pb-3 border-secondary/20">
        <a
          href="/sap"
          class={`inline-block py-2 hover:text-primary transition-colors duration-200 ${isActive('/sap') ? 'text-primary' : ''}`}
          >¿Qué es SAP?</a
        >
      </li>
      <li class="border-b pb-3 border-secondary/20">
        <a
          href="/servicios"
          class={`inline-block py-2 hover:text-primary transition-colors duration-200 ${isActive('/servicios') ? 'text-primary' : ''}`}
          >Servicios</a
        >
      </li>
      <li class="border-b pb-3 border-secondary/20">
        <a
          href="/contacto"
          class={`inline-block py-2 hover:text-primary transition-colors duration-200 ${isActive('/contacto') ? 'text-primary' : ''}`}
          >Contacto</a
        >
      </li>
    </ul>
  </nav>
</div>
<style>
  header {
    background: transparent;
    animation: header-scroll 0.3s linear both;
    animation-timeline: scroll();
    animation-range: 0 250px;
    border-bottom: 1px solid transparent;
  }

  @keyframes header-scroll {
    from {
      background: transparent;
    }
    to {
      background: var(--color-background);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      margin-top: 8px;
    }
  }

  /* Mejoras para móviles */
  @media (max-width: 768px) {
    @keyframes header-scroll {
      from {
        background: transparent;
      }
      to {
        background: var(--color-background);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 12px;
      }
    }
  }
</style>

<!-- Script para menú mobile -->
<script lang="ts" is:inline>
  // Espera a que el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn')
    const menuOverlay = document.getElementById('mobile-menu-overlay')
    const menuNav = menuOverlay?.querySelector('nav')
    const closeBtn = document.getElementById('mobile-menu-close')

    function openMenu() {
      menuOverlay?.classList.remove('opacity-0', 'pointer-events-none')
      menuOverlay?.classList.add('opacity-100')
      menuNav?.classList.remove('translate-x-full')
      menuNav?.classList.add('translate-x-0')
      document.body.style.overflow = 'hidden'
    }

    function closeMenu() {
      menuNav?.classList.add('translate-x-full')
      menuNav?.classList.remove('translate-x-0')

      // Esperar a que termine la animación antes de ocultar el overlay
      setTimeout(() => {
        menuOverlay?.classList.add('opacity-0', 'pointer-events-none')
        menuOverlay?.classList.remove('opacity-100')
      }, 150)

      document.body.style.overflow = ''
    }

    menuBtn?.addEventListener('click', openMenu)
    closeBtn?.addEventListener('click', closeMenu)

    menuOverlay?.addEventListener('click', (e) => {
      if (e.target === menuOverlay) closeMenu()
    })

    // Cerrar menú al navegar
    menuOverlay?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu)
    })

    // Cerrar menú con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (
        e.key === 'Escape' &&
        !menuOverlay?.classList.contains('pointer-events-none')
      ) {
        closeMenu()
      }
    })
  })
</script>
